{
  "name": "waios-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Form submissions are emailed to these verified Email Routing addresses
  // (Danielle, plus a copy to Jen).
  "send_email": [
    { "name": "LEADS", "allowed_destination_addresses": ["dposa@globalwellbeinggroup.com", "jen@jennifer-moss.com"] }
  ],
  "observability": { "enabled": true }
}
